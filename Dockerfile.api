FROM python:3.11-slim

LABEL maintainer="inaongit"
LABEL version="1.0"
LABEL description="API de prédiction de gravité d'accidents routiers"
LABEL project="prediction-accidents"

WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY api.py .
COPY model_logistic_regression.pkl . 
COPY model_columns.pkl .
EXPOSE 8000
#CMD ["uvicorn", "api:app", "--host", "0.0.0.0.", "--port", "8000"]
CMD ["sh", "-c", "sleep 2 && uvicorn api:app --host 0.0.0.0 --port 8000"]